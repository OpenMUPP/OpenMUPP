        "board-stlinkv21"
      ]
    },
    {
      "name": "stlinkv21-cmsis-dap",
      "displayName": "ST-Link/V2-1, CMSIS-DAP",
      "inherits": [
        "board-stlinkv21",
        "personalities-cmsis-dap"
      ]
    },
    {
      "name": "stlinkv21-dual",
      "displayName": "ST-Link/V2-1, dual image, CMSIS-DAP and WCH-Link",
      "inherits": [
        "board-stlinkv21",
        "personalities-dual"
      ]
    },
    {
      "name": "stlinkv21-wch-link",
      "displayName": "ST-Link/V2-1, WCH-Link",
      "inherits": [
        "board-stlinkv21",
        "personalities-wch-link"
      ]
    },
    {
      "name": "stlinkv2miniclone",
      "displayName": "ST-Link/V2 mini clone",
      "inherits": [
        "board-stlinkv2miniclone"
      ]
    },
    {
      "name": "stlinkv2miniclone-cmsis-dap",
      "displayName": "ST-Link/V2 mini clone, CMSIS-DAP",
      "inherits": [
        "board-stlinkv2miniclone",
        "personalities-cmsis-dap"
      ]
    },
    {
      "name": "stlinkv2miniclone-dual",
      "displayName": "ST-Link/V2 mini clone, dual image, CMSIS-DAP and WCH-Link",
      "inherits": [
        "board-stlinkv2miniclone",
        "personalities-dual"
      ]
    },
    {
      "name": "stlinkv2miniclone-wch-link",
      "displayName": "ST-Link/V2 mini clone, WCH-Link",
      "inherits": [
        "board-stlinkv2miniclone",
        "personalities-wch-link"
      ]
    },
    {
      "name": "weacth523",
      "displayName": "WeAct STM32H523",
      "inherits": [
        "board-weacth523"
      ]
    },
    {
      "name": "weacth523-cmsis-dap",
      "displayName": "WeAct STM32H523, CMSIS-DAP",
      "inherits": [
        "board-weacth523",
        "personalities-cmsis-dap"
      ]
    },
    {
      "name": "weacth523-dual",
      "displayName": "WeAct STM32H523, dual image, CMSIS-DAP and WCH-Link",
      "inherits": [
        "board-weacth523",
        "personalities-dual"
      ]
    },
    {
      "name": "weacth523-wch-link",
      "displayName": "WeAct STM32H523, WCH-Link",
      "inherits": [
        "board-weacth523",
        "personalities-wch-link"
      ]
    },
    {
      "name": "weacth523-debug",
      "displayName": "WeAct STM32H523, CMSIS-DAP, Debug",
      "inherits": [
        "debug",
        "board-weacth523",
        "personalities-cmsis-dap"
      ]
    },
    {
      "name": "ydch32v307",
      "displayName": "YD-CH32V307VCT6 (stub image)",
      "inherits": [
        "board-ydch32v307"
      ]
    },
    {
      "name": "ydch32v307-cmsis-dap",
      "displayName": "YD-CH32V307VCT6, CMSIS-DAP without the RISC-V bridge (firmware image)",
      "inherits": [
        "board-ydch32v307",
        "personalities-cmsis-dap-no-rv-bridge"
      ],
      "cacheVariables": {
        "MUPP_CH32_STUB_IMAGE": {
          "type": "BOOL",
          "value": "OFF"
        }
      }
    },
    {
      "name": "ydch32v307-wch-link",
      "displayName": "YD-CH32V307VCT6, WCH-Link (firmware image)",
      "inherits": [
        "board-ydch32v307",
        "personalities-wch-link"
      ],
      "cacheVariables": {
        "MUPP_CH32_STUB_IMAGE": {
          "type": "BOOL",
          "value": "OFF"
        }
      }
    },
    {
      "name": "host-tests",
      "displayName": "Host unit tests",
      "description": "Native build of the unit tests (no toolchain file)",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
