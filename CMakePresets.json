      "configurePreset": "stlinkv2-wch-link"
    },
    {
      "name": "stlinkv2miniclone",
      "configurePreset": "stlinkv2miniclone"
    },
    {
      "name": "stlinkv2miniclone-cmsis-dap",
      "configurePreset": "stlinkv2miniclone-cmsis-dap"
    },
    {
      "name": "stlinkv2miniclone-dual",
      "configurePreset": "stlinkv2miniclone-dual"
    },
    {
      "name": "stlinkv2miniclone-wch-link",
      "configurePreset": "stlinkv2miniclone-wch-link"
