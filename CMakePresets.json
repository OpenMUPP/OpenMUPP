    {
      "name": "weacth523",
      "configurePreset": "weacth523"
    },
    {
      "name": "weacth523-cmsis-dap",
      "configurePreset": "weacth523-cmsis-dap"
    },
    {
      "name": "weacth523-dual",
      "configurePreset": "weacth523-dual"
    },
    {
      "name": "weacth523-wch-link",
      "configurePreset": "weacth523-wch-link"
    },
    {
      "name": "weacth523-debug",
      "configurePreset": "weacth523-debug"
    },
    {
      "name": "host-tests",
      "configurePreset": "host-tests",
      "targets": [
        "vsl-tests"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "host-tests",
      "configurePreset": "host-tests",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
