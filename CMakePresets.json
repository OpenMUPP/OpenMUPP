{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Cross build with the Arm GNU Toolchain (GCC_TOOLCHAIN_PREFIX from the environment, default /usr)",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/gcc_arm.cmake",
      "cacheVariables": {
        "GCC_TOOLCHAIN_PREFIX": {
          "type": "STRING",
          "value": "$env{GCC_TOOLCHAIN_PREFIX}"
        },
        "CMAKE_EXPORT_COMPILE_COMMANDS": {
          "type": "BOOL",
          "value": "TRUE"
        },
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "board-mini",
      "description": "Board mini",
      "hidden": true,
      "inherits": [
        "base"
      ],
      "cacheVariables": {
        "BOARD": "mini"
      }
    },
    {
      "name": "board-otheruse",
      "description": "Board otheruse",
      "hidden": true,
      "inherits": [
        "base"
      ],
      "cacheVariables": {
        "BOARD": "otheruse"
      }
    },
    {
      "name": "board-stlinkv21",
      "description": "Board stlinkv21",
      "hidden": true,
      "inherits": [
        "base"
      ],
      "cacheVariables": {
        "BOARD": "stlinkv21"
      }
    },
    {
      "name": "board-stlinkv2miniclone",
      "description": "Board stlinkv2miniclone",
      "hidden": true,
      "inherits": [
        "base"
      ],
      "cacheVariables": {
        "BOARD": "stlinkv2miniclone"
      }
    },
    {
      "name": "board-weacth523",
      "description": "Board weacth523",
      "hidden": true,
      "inherits": [
        "base"
      ],
      "cacheVariables": {
        "BOARD": "weacth523"
      }
    },
    {
      "name": "base-riscv",
      "hidden": true,
      "inherits": [
        "base"
      ],
      "description": "Cross build with the RISC-V GCC (RISCV_GCC_TOOLCHAIN_PREFIX from the environment, default /usr)",
      "toolchainFile": "${sourceDir}/cmake/gcc_riscv.cmake",
      "cacheVariables": {
        "GCC_TOOLCHAIN_PREFIX": {
          "type": "STRING",
          "value": "$env{RISCV_GCC_TOOLCHAIN_PREFIX}"
        }
      }
    },
    {
      "name": "board-ydch32v307",
      "description": "Board ydch32v307",
      "hidden": true,
      "inherits": [
        "base-riscv"
      ],
      "cacheVariables": {
        "BOARD": "ydch32v307"
      }
    },
    {
      "name": "personalities-cmsis-dap",
      "description": "CMSIS-DAP personality",
      "hidden": true,
      "cacheVariables": {
        "MUPP_PERSONALITIES": "cmsis-dap"
      }
    },
    {
      "name": "personalities-versaloon",
      "description": "Versaloon personality",
      "hidden": true,
      "cacheVariables": {
        "MUPP_PERSONALITIES": "versaloon"
      }
    },
    {
      "name": "personalities-dual",
      "description": "Dual image with CMSIS-DAP and WCH-Link, CMSIS-DAP as default personality",
      "hidden": true,
      "cacheVariables": {
        "MUPP_PERSONALITIES": "cmsis-dap,wch-link",
        "MUPP_DEFAULT_PERSONALITY": "cmsis-dap"
      }
    },
    {
      "name": "personalities-wch-link",
      "description": "WCH-Link personality",
      "hidden": true,
      "cacheVariables": {
        "MUPP_PERSONALITIES": "wch-link"
      }
    },
    {
      "name": "personalities-wch-link-wch-id",
      "description": "WCH-Link personality with the USB ID of WCH, for personal use only",
      "hidden": true,
      "inherits": [
        "personalities-wch-link"
      ],
      "cacheVariables": {
        "MUPP_WCH_LINK_WCH_USB_ID": {
          "type": "BOOL",
          "value": "ON"
        }
      }
    },
    {
      "name": "personalities-cmsis-dap-no-rv-bridge",
      "description": "CMSIS-DAP personality without the RISC-V DTM bridge",
      "hidden": true,
      "inherits": [
        "personalities-cmsis-dap"
      ],
      "cacheVariables": {
        "MUPP_CMSIS_DAP_RV_BRIDGE": {
          "type": "BOOL",
          "value": "OFF"
        }
      }
    },
    {
      "name": "debug",
      "description": "Debug build: debug log on the serial port, SWD on",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "mini",
      "displayName": "Versaloon Mini",
      "inherits": [
        "board-mini"
      ]
    },
    {
      "name": "mini-versaloon",
      "displayName": "Versaloon Mini, Versaloon",
      "inherits": [
        "board-mini",
        "personalities-versaloon"
      ]
    },
    {
      "name": "mini-cmsis-dap",
      "displayName": "Versaloon Mini, CMSIS-DAP",
      "inherits": [
        "board-mini",
        "personalities-cmsis-dap"
      ]
    },
    {
      "name": "mini-cmsis-dap-no-rv-bridge",
      "displayName": "Versaloon Mini, CMSIS-DAP without the RISC-V bridge",
      "inherits": [
        "board-mini",
        "personalities-cmsis-dap-no-rv-bridge"
      ]
    },
    {
      "name": "mini-dual",
      "displayName": "Versaloon Mini, dual image, CMSIS-DAP and WCH-Link",
      "inherits": [
        "board-mini",
        "personalities-dual"
      ]
    },
    {
      "name": "mini-debug",
      "displayName": "Versaloon Mini, CMSIS-DAP without the RISC-V bridge, Debug",
      "inherits": [
        "debug",
        "board-mini",
        "personalities-cmsis-dap-no-rv-bridge"
      ]
    },
    {
      "name": "mini-wch-link",
      "displayName": "Versaloon Mini, WCH-Link",
      "inherits": [
        "board-mini",
        "personalities-wch-link"
      ]
    },
    {
      "name": "mini-wch-link-wch-id",
      "displayName": "Versaloon Mini, WCH-Link, USB ID of WCH",
      "inherits": [
        "board-mini",
        "personalities-wch-link-wch-id"
      ]
    },
    {
      "name": "otheruse",
      "displayName": "OtherUse",
      "inherits": [
        "board-otheruse"
      ]
    },
    {
      "name": "otheruse-cmsis-dap",
      "displayName": "OtherUse, CMSIS-DAP",
      "inherits": [
        "board-otheruse",
        "personalities-cmsis-dap"
      ]
    },
    {
      "name": "otheruse-dual",
      "displayName": "OtherUse, dual image, CMSIS-DAP and WCH-Link",
      "inherits": [
        "board-otheruse",
        "personalities-dual"
      ]
    },
    {
      "name": "otheruse-wch-link",
