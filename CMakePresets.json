{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Cross build with the Arm GNU Toolchain (GCC_TOOLCHAIN_PREFIX from the environment, default /usr)",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/gcc_arm.cmake",
      "cacheVariables": {
        "GCC_TOOLCHAIN_PREFIX": {
          "type": "STRING",
          "value": "$env{GCC_TOOLCHAIN_PREFIX}"
        },
        "CMAKE_EXPORT_COMPILE_COMMANDS": {
          "type": "BOOL",
          "value": "TRUE"
        },
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "board-mini",
      "description": "Board mini",
      "hidden": true,
      "inherits": [
        "base"
      ],
      "cacheVariables": {
        "BOARD": "mini"
      }
    },
    {
      "name": "board-otheruse",
      "description": "Board otheruse",
      "hidden": true,
      "inherits": [
        "base"
      ],
      "cacheVariables": {
        "BOARD": "otheruse"
      }
    },
    {
      "name": "board-stlinkv2",
      "description": "Board stlinkv2",
      "hidden": true,
      "inherits": [
        "base"
      ],
      "cacheVariables": {
        "BOARD": "stlinkv2"
      }
    },
    {
      "name": "board-stlinkv2miniclone",
      "description": "Board stlinkv2miniclone",
      "hidden": true,
      "inherits": [
        "base"
      ],
      "cacheVariables": {
        "BOARD": "stlinkv2miniclone"
      }
    },
    {
      "name": "board-weacth523",
      "description": "Board weacth523",
      "hidden": true,
      "inherits": [
        "base"
      ],
      "cacheVariables": {
        "BOARD": "weacth523"
      }
    },
    {
      "name": "personalities-cmsis-dap",
      "description": "CMSIS-DAP personality",
      "hidden": true,
      "cacheVariables": {
        "VSL_PERSONALITIES": "cmsis-dap"
      }
    },
    {
      "name": "personalities-dual",
      "description": "Dual image with CMSIS-DAP and WCH-Link, CMSIS-DAP as default personality",
      "hidden": true,
      "cacheVariables": {
        "VSL_PERSONALITIES": "cmsis-dap,wch-link",
        "VSL_DEFAULT_PERSONALITY": "cmsis-dap"
      }
    },
    {
      "name": "personalities-wch-link",
      "description": "WCH-Link personality",
      "hidden": true,
      "cacheVariables": {
        "VSL_PERSONALITIES": "wch-link"
      }
    },
    {
      "name": "personalities-wch-link-wch-id",
      "description": "WCH-Link personality with the USB ID of WCH, for personal use only",
      "hidden": true,
      "inherits": [
        "personalities-wch-link"
      ],
      "cacheVariables": {
        "VSL_WCH_LINK_WCH_USB_ID": {
          "type": "BOOL",
          "value": "ON"
        }
      }
    },
    {
      "name": "debug",
      "description": "Debug build: debug log on the serial port, SWD on",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "mini",
      "displayName": "Versaloon Mini",
      "inherits": [
        "board-mini"
      ]
    },
    {
      "name": "mini-cmsis-dap",
      "displayName": "Versaloon Mini, CMSIS-DAP",
      "inherits": [
        "board-mini",
        "personalities-cmsis-dap"
      ]
    },
    {
      "name": "mini-dual",
      "displayName": "Versaloon Mini, dual image, CMSIS-DAP and WCH-Link",
      "inherits": [
        "board-mini",
        "personalities-dual"
      ]
    },
    {
      "name": "mini-debug",
      "displayName": "Versaloon Mini, CMSIS-DAP, Debug",
      "inherits": [
        "debug",
        "board-mini",
        "personalities-cmsis-dap"
      ]
    },
    {
      "name": "mini-wch-link",
      "displayName": "Versaloon Mini, WCH-Link",
      "inherits": [
        "board-mini",
        "personalities-wch-link"
      ]
    },
    {
      "name": "mini-wch-link-wch-id",
      "displayName": "Versaloon Mini, WCH-Link, USB ID of WCH",
      "inherits": [
        "board-mini",
        "personalities-wch-link-wch-id"
      ]
    },
    {
      "name": "otheruse",
      "displayName": "OtherUse",
      "inherits": [
        "board-otheruse"
      ]
    },
    {
      "name": "otheruse-cmsis-dap",
      "displayName": "OtherUse, CMSIS-DAP",
      "inherits": [
        "board-otheruse",
        "personalities-cmsis-dap"
      ]
    },
    {
      "name": "otheruse-dual",
      "displayName": "OtherUse, dual image, CMSIS-DAP and WCH-Link",
      "inherits": [
        "board-otheruse",
        "personalities-dual"
      ]
    },
    {
      "name": "otheruse-wch-link",
      "displayName": "OtherUse, WCH-Link",
      "inherits": [
        "board-otheruse",
        "personalities-wch-link"
      ]
    },
    {
      "name": "stlinkv2",
      "displayName": "ST-Link/V2",
      "inherits": [
        "board-stlinkv2"
      ]
    },
    {
      "name": "stlinkv2-cmsis-dap",
      "displayName": "ST-Link/V2, CMSIS-DAP",
      "inherits": [
        "board-stlinkv2",
        "personalities-cmsis-dap"
      ]
    },
    {
      "name": "stlinkv2-dual",
      "displayName": "ST-Link/V2, dual image, CMSIS-DAP and WCH-Link",
      "inherits": [
        "board-stlinkv2",
        "personalities-dual"
      ]
    },
    {
      "name": "stlinkv2-wch-link",
      "displayName": "ST-Link/V2, WCH-Link",
      "inherits": [
        "board-stlinkv2",
        "personalities-wch-link"
      ]
    },
    {
      "name": "stlinkv2miniclone",
      "displayName": "ST-Link/V2 mini clone",
      "inherits": [
        "board-stlinkv2miniclone"
      ]
    },
    {
      "name": "stlinkv2miniclone-cmsis-dap",
      "displayName": "ST-Link/V2 mini clone, CMSIS-DAP",
      "inherits": [
        "board-stlinkv2miniclone",
        "personalities-cmsis-dap"
      ]
    },
    {
      "name": "stlinkv2miniclone-dual",
      "displayName": "ST-Link/V2 mini clone, dual image, CMSIS-DAP and WCH-Link",
      "inherits": [
        "board-stlinkv2miniclone",
        "personalities-dual"
      ]
    },
    {
      "name": "stlinkv2miniclone-wch-link",
      "displayName": "ST-Link/V2 mini clone, WCH-Link",
      "inherits": [
        "board-stlinkv2miniclone",
        "personalities-wch-link"
      ]
    },
    {
      "name": "weacth523",
      "displayName": "WeAct STM32H523",
      "inherits": [
        "board-weacth523"
      ]
    },
    {
      "name": "weacth523-cmsis-dap",
      "displayName": "WeAct STM32H523, CMSIS-DAP",
      "inherits": [
        "board-weacth523",
        "personalities-cmsis-dap"
      ]
    },
    {
      "name": "weacth523-dual",
      "displayName": "WeAct STM32H523, dual image, CMSIS-DAP and WCH-Link",
      "inherits": [
        "board-weacth523",
        "personalities-dual"
      ]
    },
    {
      "name": "weacth523-wch-link",
      "displayName": "WeAct STM32H523, WCH-Link",
      "inherits": [
        "board-weacth523",
        "personalities-wch-link"
      ]
    },
    {
      "name": "weacth523-debug",
      "displayName": "WeAct STM32H523, CMSIS-DAP, Debug",
      "inherits": [
        "debug",
        "board-weacth523",
        "personalities-cmsis-dap"
      ]
    },
    {
      "name": "host-tests",
      "displayName": "Host unit tests",
      "description": "Native build of the unit tests (no toolchain file)",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "mini",
      "configurePreset": "mini"
    },
    {
      "name": "mini-cmsis-dap",
      "configurePreset": "mini-cmsis-dap"
    },
    {
      "name": "mini-dual",
      "configurePreset": "mini-dual"
    },
    {
      "name": "mini-debug",
      "configurePreset": "mini-debug"
    },
    {
      "name": "mini-wch-link",
      "configurePreset": "mini-wch-link"
    },
    {
      "name": "mini-wch-link-wch-id",
      "configurePreset": "mini-wch-link-wch-id"
    },
    {
      "name": "otheruse",
      "configurePreset": "otheruse"
    },
    {
