#!/bin/sh
# This is a helper script for always performing a clang-format before committing.

git diff --cached --name-only | while IFS= read -r FILE; do
   # Only format existing files
   if [ ! -f "$FILE" ]; then
      continue
   fi
   # Only format C++ files
   case "$FILE" in
   *.c | *.h | *.cpp | *.cc | *.hpp) ;;
   *) continue ;;
   esac
   echo "$FILE"
   clang-format -i -style=file "$FILE"

   # Ensure the formatted files are added
   git add "$FILE"
done
