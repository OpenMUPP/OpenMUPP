# udev rules for openmupp-bootloader and the ROM USB DFU of the STM32H5
# (docs/firmware-update.md). They give a normal user access to the
# bootloader, so tools/vsl_personality.py can read the product string and
# the serial number of openmupp-bootloader, and dfu-util can write the
# firmware through the ROM DFU. Copy this file to
# /etc/udev/rules.d/, run "udevadm control --reload", and start the
# bootloader again.

# The number is below 73: systemd applies the uaccess tag in 73-seat-late.rules.
# The ST virtual COM port uses the same ID, so the rule also checks the
# product string.
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", ATTRS{product}=="Bootloader", MODE="0660", TAG+="uaccess"
# The ROM USB DFU of the STM32 devices
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="df11", MODE="0660", TAG+="uaccess"
